        <mxCell id="titulo" value="&lt;b&gt;Clínica Sonrisa Feliz — Diagrama de Clases V7&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" parent="1" vertex="1">
          <mxGeometry x="40" y="30" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="nota" value="Notación UML 2. Paquetes (capas): View → Controller → LogicaDeNegocio → Persistencia;&lt;br&gt;Entity y Excepciones son usados por todas las capas.&lt;br&gt;Main crea repositorios, servicios y controllers y se los pasa a MainFrame.&lt;br&gt;Las referencias entre clases del sistema se muestran como asociaciones (nombre, rol y&lt;br&gt;multiplicidad) y no se repiten como atributos.&lt;br&gt;Serializable y Comparable: interfaces de Java que implementa la clase (notación de bola).&lt;br&gt;javax.swing:: y java.lang:: son clases de la librería de Java (no pertenecen al sistema).&lt;br&gt;Validaciones: reglas de formato compartidas por servicios y controllers.&lt;br&gt;Los servicios lanzan las excepciones del paquete Excepciones." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;spacingLeft=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="40" y="3664" width="620" height="178" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>